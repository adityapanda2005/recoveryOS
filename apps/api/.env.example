# --- Database ---
DATABASE_URL=postgresql+psycopg2://recoveros:recoveros_dev_pw@localhost:5432/recoveros

# --- AI Provider ---
# Leave ANTHROPIC_API_KEY blank to run fully on MockAIProvider (no cost, deterministic).
# Set AI_PROVIDER=anthropic once you have a key from console.anthropic.com.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_SECRET_KEY=change_me_in_production

# --- Policy defaults (deterministic, not AI-controlled) ---
MAX_RETRY_ATTEMPTS=3
MIN_RETRY_COOLDOWN_SECONDS=1800
MAX_COMMUNICATION_ATTEMPTS=4
CONFIDENCE_THRESHOLD=0.65
MAX_INCENTIVE_PERCENT=10
